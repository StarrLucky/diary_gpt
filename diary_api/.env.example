# === API Security ===
# Секретный ключ для доступа к API
# Сгенерировать: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
DIARY_API_KEY=

# === ngrok Tunnel ===
# Зарегистрироваться: https://ngrok.com (бесплатно)
# Authtoken: https://dashboard.ngrok.com/get-started/your-authtoken
NGROK_AUTHTOKEN=

# Статический домен: https://dashboard.ngrok.com/domains -> New Domain
# Формат: something-random.ngrok-free.dev
NGROK_DOMAIN=

# === Опционально ===
# DB_PATH=data/diary.db
